{
  "name": "hawya-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source, local-first brand system production studio.",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:browser": "playwright test --project=chromium",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "~4.3.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "~6.0.5",
    "tailwindcss": "~4.3.0",
    "typescript": "7.0.2",
    "vite": "~8.1.5",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bashar-Omar/Hawya-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/Bashar-Omar/Hawya-Studio/issues"
  },
  "homepage": "https://github.com/Bashar-Omar/Hawya-Studio#readme"
}
