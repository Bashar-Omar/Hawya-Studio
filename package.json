{
  "name": "hawya-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, local-first brand system production studio.",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-pwa-shell.mjs",
    "build:static-fallback": "tsc -b && vite build --base=/Hawya-Studio/ && node scripts/generate-pwa-shell.mjs /Hawya-Studio/",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:browser": "playwright test --project=chromium",
    "test:compatibility": "playwright test tests/e2e/stage11-release-qa.spec.ts",
    "test:static-fallback": "playwright test --config=playwright.static-fallback.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:performance": "node scripts/check-performance-budgets.mjs",
    "check:security-policy": "node scripts/check-security-policy.mjs",
    "check:release-docs": "node scripts/check-release-docs.mjs",
    "check:static-fallback": "node scripts/check-static-fallback.mjs",
    "check:security": "pnpm audit --prod --audit-level high",
    "inventory:licenses": "pnpm licenses list --prod --json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "zod": "4.6.5",
    "@cantoo/fontkit": "2.0.12",
    "colorjs.io": "0.7.1",
    "dompurify": "3.4.15",
    "immer": "11.1.18",
    "react-moveable": "0.56.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "~4.3.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "~6.0.5",
    "tailwindcss": "~4.3.0",
    "typescript": "7.0.2",
    "vite": "~8.1.5",
    "vitest": "4.1.11",
    "fake-indexeddb": "6.2.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bashar-Omar/Hawya-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/Bashar-Omar/Hawya-Studio/issues"
  },
  "homepage": "https://github.com/Bashar-Omar/Hawya-Studio#readme"
}
